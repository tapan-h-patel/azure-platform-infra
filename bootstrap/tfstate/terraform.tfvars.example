allowed_public_ipv4_addresses = ["203.0.113.10"] # Documentation IP; replace.
state_group_object_ids          = ["00000000-0000-0000-0000-000000000000"]
replication_type             = "ZRS"
tags = {
  owner = "platform-team"
}
