# Copy to terraform.tfvars (ignored) and replace identifiers and example IP.
tenant_id       = "00000000-0000-0000-0000-000000000000"
subscription_id = "00000000-0000-0000-0000-000000000000"
location        = "uksouth"

naming = {
  workload    = "tfstate"
  environment = "shared"
  region      = "uks"
  instance    = "001"
  suffix      = "abc123" # Choose once; preserve it. Check global availability.
