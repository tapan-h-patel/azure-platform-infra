# Copy to ignored backend.hcl and supply customer-owned storage settings.
# Ensure storage exists, network access works, and Entra data access is granted.
resource_group_name  = "<customer-state-resource-group>"
storage_account_name = "<customer-state-storage-account>"
container_name       = "tfstate"
key                  = "<customer-code>/foundation/management-groups.tfstate"
tenant_id            = "00000000-0000-0000-0000-000000000000"
subscription_id      = "00000000-0000-0000-0000-000000000000"
use_azuread_auth     = true
use_cli              = true
